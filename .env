# URL de la API (sin el prefijo /api/v1, que se añade en la configuración)
# Los WebSockets se derivan automáticamente de esta URL (https -> wss)
VITE_API_URL=https://romeroapi-production-5dec.up.railway.app

# Ambiente (development | production)
VITE_NODE_ENV=development

# Otras configuraciones opcionales
VITE_APP_TITLE=Transportes Romero
VITE_SUNAT_BETA=true