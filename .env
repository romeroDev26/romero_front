# URL de la API (sin el prefijo /api/v1, que se añade en la configuración)
VITE_API_URL=https://romero-api.onrender.com

# URL del WebSocket para selección de asientos en tiempo real
VITE_WS_URL=wss://romero-api.onrender.com

# Ambiente (development | production)
VITE_NODE_ENV=development

# Otras configuraciones opcionales
VITE_APP_TITLE=Transportes Romero
VITE_SUNAT_BETA=true