# ============================================
# VARIABLES DE ENTORNO - TRANSPORTES ROMERO
# ============================================

# URL de la API Backend
# IMPORTANTE: NO incluir el prefijo /api/v1 (se añade automáticamente)
# Los WebSockets se derivan automáticamente (https -> wss)
# 
# Desarrollo local: http://localhost:8000
# Producción: https://romeroapi-production-5dec.up.railway.app
VITE_API_URL=https://romeroapi-production-5dec.up.railway.app

# Ambiente de ejecución
# Valores: development | production
VITE_NODE_ENV=development

# Título de la aplicación (opcional)
VITE_APP_TITLE=Transportes Romero

# Modo SUNAT Beta (opcional)
VITE_SUNAT_BETA=true

# ============================================
# CONFIGURACIÓN PARA VERCEL
# ============================================
# 
# Variables requeridas en Vercel Environment Variables:
# 
# 1. VITE_API_URL
#    - Valor para producción: https://romeroapi-production-5dec.up.railway.app
#    - Valor para preview/development: (tu URL de staging si existe)
#
# 2. VITE_NODE_ENV
#    - Valor: production
#
# NOTA: Los WebSockets se configuran automáticamente desde VITE_API_URL
# No es necesario configurar VITE_WS_URL por separado
